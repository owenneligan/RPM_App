# ── Supabase (required for auth + multi-user) ──────────────────────────────
# Get these from: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbG...          # Safe to expose — RLS enforces isolation

# ── Server-side only (NEVER expose to frontend) ─────────────────────────────
# Service role key — bypasses RLS, used to verify JWTs and write usage events
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...       # Treat like a DB root password

# ── Anthropic AI (optional — can also be set in app Settings page) ──────────
# ANTHROPIC_API_KEY=sk-ant-api03-...
